{
  "name": "carpicker",
  "version": "0.1.0",
  "private": true,
  "description": "CarPicker Ireland: a free quiz that helps beginners pick a car, including Northern Ireland import costs.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-test.cjs",
    "fetch-photos": "python3 scripts/fetch-car-photos.py",
    "check-links": "vite-node --config vitest.config.ts scripts/check-links.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.469.0",
    "next": "15.5.29",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "axe-core": "4.10.2",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
